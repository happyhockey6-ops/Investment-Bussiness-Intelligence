# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored. This file documents required/optional
# configuration only; it must never contain a real secret.

# --- Runtime environment ---
# One of: development | test | production
IBI_ENVIRONMENT=development

# --- Logging ---
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
IBI_LOG_LEVEL=INFO
# One of: json | console  (json is recommended for production/observability)
IBI_LOG_FORMAT=console

# --- Database (PostgreSQL) ---
# Standard SQLAlchemy/psycopg URL. Phase 0 does not require a live database
# to import the codebase, but the test/integration suite and Alembic need one.
IBI_DATABASE_URL=postgresql+psycopg://ibi:ibi@localhost:5432/ibi_dev

# --- AI provider selection (provider-agnostic; see src/ibi/providers/ai) ---
# One of: claude | local | none
# "none" disables AI calls entirely (deterministic-only mode).
IBI_AI_PROVIDER=none

# Only required when IBI_AI_PROVIDER=claude. Never hard-code this anywhere.
ANTHROPIC_API_KEY=

# Model routing tiers (see src/ibi/providers/ai/router.py). Left blank in
# Phase 0 — no engine calls these yet. Documented so the shape exists.
IBI_AI_MODEL_LOW=
IBI_AI_MODEL_STANDARD=
IBI_AI_MODEL_HIGH=

# Optional soft budget ceiling in USD/month for AI spend. Enforcement is not
# implemented in Phase 0; this only reserves the configuration surface.
IBI_AI_MONTHLY_BUDGET_USD=

# --- Market data provider selection (provider-agnostic; see
# src/ibi/providers/market_data) ---
# One of: null | other
# "null" is the default no-op provider used for tests/dev; it never returns
# fabricated data, only UNKNOWN. No production vendor is selected in Phase 0.
IBI_MARKET_DATA_PROVIDER=null
IBI_MARKET_DATA_API_KEY=
