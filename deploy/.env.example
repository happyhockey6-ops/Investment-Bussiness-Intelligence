# Copy to the repository root as .env. See docs/deploy.md before starting.
POSTGRES_PASSWORD=<CHANGE_ME>
TRUSTY_BACKUP_DIR=/absolute/path/outside/checkout/trusty-backups
TRUSTY_CODE_COMMIT=<SET_FROM_GIT>
IBI_ENVIRONMENT=production
IBI_LOG_LEVEL=INFO
IBI_LOG_FORMAT=json
IBI_SEC_USER_AGENT="Trusty Investment Research <CONTACT_EMAIL>"
IBI_API_PORT=8000
# Compose fixes these container values and constructs IBI_DATABASE_URL from
# POSTGRES_PASSWORD: postgresql+psycopg://ibi:<password>@db:5432/ibi
# IBI_DEPLOYMENT=container
# IBI_API_HOST=0.0.0.0
# IBI_RAW_DATA_DIR=/var/lib/trusty/raw
